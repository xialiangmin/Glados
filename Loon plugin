#!name=GLaDOS Auto Checkin
#!desc=自动获取Cookie并每日签到
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png

[Script]

# 1. 抓取 Cookie（只有你手动点签到时才会触发）
http-request ^https:\/\/glados\.cloud\/api\/user\/checkin script-path=https://raw.githubusercontent.com/xialiangmin/Glados/refs/heads/main/glados_cookie.js, requires-body=true, timeout=60, tag=GLaDOS获取Cookie

# 2. 每日7-11点随机签到，每60分钟执行一次
cron "0,60 7-11 * * *" script-path=https://raw.githubusercontent.com/xialiangmin/Glados/refs/heads/main/glados_checkin.js, timeout=60, tag=GLaDOS自动签到


[MITM]
hostname = glados.cloud
